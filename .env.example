# ── Required ──────────────────────────────────────────────
DATABASE_URL="postgresql://convoly:convoly@localhost:5432/convoly"
# Random string, at least 32 characters (openssl rand -base64 48). Encrypts channel credentials.
APP_SECRET=""
# Public https URL of the app – needed for Telegram/Meta webhooks.
APP_URL="http://localhost:3000"

# ── Branding (optional) ───────────────────────────────────
NEXT_PUBLIC_APP_NAME="Convoly"
NEXT_PUBLIC_SUPPORT_EMAIL="support@example.com"

# ── Billing (optional, Stripe) ────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_BUSINESS=""

# ── Email (optional, Resend) – invites & password resets ──
RESEND_API_KEY=""
EMAIL_FROM="Convoly <hello@yourdomain.com>"

# ── Serverless hosts only ─────────────────────────────────
# Set DISABLE_INTERNAL_SCHEDULER=1 and call GET /api/cron/tick every minute
# with "Authorization: Bearer $CRON_SECRET".
DISABLE_INTERNAL_SCHEDULER=""
CRON_SECRET=""

# ── Platform owner ────────────────────────────────────────
# Comma-separated emails that can open /admin (all customers, plans, revenue).
SUPERADMIN_EMAILS="you@yourcompany.com"
# Optional: shown on the Terms / Privacy pages.
NEXT_PUBLIC_COMPANY_NAME="Your Company Ltd"
NEXT_PUBLIC_COMPANY_ADDRESS="Street, City, Country"
NEXT_PUBLIC_GOVERNING_LAW="India"
